<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Muse 录音助手"
                android:textSize="20sp"
                android:textStyle="bold" />

            <personal.muse.recorder.RecordButtonView
                android:id="@+id/recordButton"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true" />

            <personal.muse.recorder.WaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="点红色按钮开始录音"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/filesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="录音文件"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pendingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/uploadProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/uploadStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="14sp" />

            <Button
                android:id="@+id/retryUploadButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="立即重试上传"
                android:visibility="gone" />

            <Button
                android:id="@+id/settingsToggleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="⚙️ 配置（S3 与录音设置）" />

            <LinearLayout
                android:id="@+id/settingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="S3 存储设置（改完点保存，会自动上传一次）"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="云厂商预置（选中自动填好地址和区域，可再手改）" />

                <Spinner
                    android:id="@+id/presetSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Endpoint（如 R2: https://&lt;AccountID&gt;.r2.cloudflarestorage.com）" />

                <EditText
                    android:id="@+id/endpointInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="https://…"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="区域 Region（R2 填 auto，B2/阿里/腾讯填对应的区域代号）" />

                <EditText
                    android:id="@+id/regionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="auto"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="存储桶 Bucket（腾讯云的桶名要带 -APPID 后缀）" />

                <EditText
                    android:id="@+id/bucketInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="recordings"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Access Key ID" />

                <EditText
                    android:id="@+id/accessKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="AccessKey"
                    android:inputType="text"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Secret Access Key（只存在本机，不要发给任何人）" />

                <EditText
                    android:id="@+id/secretKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="SecretKey"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <CheckBox
                    android:id="@+id/virtualStyleCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="虚拟主机风格（桶名放域名前；阿里/腾讯/AWS/七牛勾选，R2/B2 不勾）" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="每段时长（分钟，默认 60）" />

                <EditText
                    android:id="@+id/segmentMinutesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="60"
                    android:inputType="number"
                    android:singleLine="true" />

                <CheckBox
                    android:id="@+id/wifiOnlyCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="仅在 Wi‑Fi / 不计流量网络时上传" />

                <CheckBox
                    android:id="@+id/deleteAfterUploadCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上传成功后删除本地片段（省空间）" />

                <CheckBox
                    android:id="@+id/autoResumeCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手机重启后自动恢复录音" />

                <Button
                    android:id="@+id/saveSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="保存设置" />

                <Button
                    android:id="@+id/batteryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="允许后台运行（关闭电池优化）" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="说明：录音按天存进桶里（&lt;日期&gt;/rec_….m4a），事件标记在 markers/ 里。上传全自动：每段录完自动传、每分钟自动重试、改完配置立刻传；持续失败超过半小时会出现手动重试按钮。48 kbps 下每小时约 21 MB。录到与他人对话时请先征得同意。"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9D9DE" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAFAFC"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="事件标记"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lastEventText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="还没有标记"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/convCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/convCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 对话"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/convCardState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="点一下开始"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/meetingCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/meetingCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 会议"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/meetingCardState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="点一下开始"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/selfNoteButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="🎙 自述录音 · 按住说话，松开结束" />
    </LinearLayout>
</LinearLayout>
